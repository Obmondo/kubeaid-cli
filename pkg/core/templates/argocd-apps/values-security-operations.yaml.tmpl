# Rendered by kubeaid-cli from cluster.securityOperations in general.yaml; edit
# that and render again (kubeaid-cli siem render) rather than this file. Chart:
# KubeAid argocd-helm-charts/security-operations (README.md there).
domain: {{ .SecOps.Domain }}
hosts:
  wazuh: {{ .SecOps.WazuhHost }}
  iris: {{ .SecOps.IRISHost }}
  misp: {{ .SecOps.MISPHost }}
  velociraptor: {{ .SecOps.VelociraptorHost }}

keycloak:
  # The browser-facing URL: it is the issuer in every token.
  url: {{ .SecOps.KeycloakURL }}
{{- with .SecOps.KeycloakInternalURL }}
  # The same Keycloak as the pods reach it. Every back-channel call uses it, so
  # SSO no longer depends on an address that changes when a Service is recreated.
  internalURL: {{ . }}
{{- end }}
  realm: {{ .SecOps.KeycloakRealm }}

operators:
  adminRole: {{ .SecOps.AdminRole }}
  analystRole: {{ .SecOps.AnalystRole }}

tenantWazuh:
  agentHost: {{ .SecOps.AgentHost }}
  hostPrefix: {{ .SecOps.HostPrefix }}wazuh-

tenants:
{{- range .SecOps.Tenants }}
  - code: "{{ .Code }}"
    name: {{ .NameJSON }}
    {{- if .RetentionDays }}
    retentionDays: {{ .RetentionDays }}
    {{- end }}
    agentPorts:
      registration: {{ .RegistrationPort }}
      events: {{ .EventsPort }}
{{- else }} []
{{- end }}

{{- if .SecOps.Backup.Enabled }}
# Backups of the SOC's own state (securityOperations.backup in general.yaml;
# security-operations README, "Backups"). Velero copies the volumes, the
# OpenSearch snapshot CronJobs the alert indices, and the two databases back
# themselves up further down in their own blocks.
backup:
  enabled: true
  objectStore:
    bucket: {{ .SecOps.Backup.Bucket }}
    endpoint: {{ .SecOps.Backup.Endpoint | printf "%q" }}
    region: {{ .SecOps.Backup.Region }}
    basePath: {{ .SecOps.Backup.BasePath }}
    credentialsSecret: {{ .SecOps.Backup.CredentialsSecret }}
    pathStyleAccess: {{ .SecOps.Backup.PathStyleAccess }}
  velero:
    namespace: {{ .SecOps.Backup.VeleroNamespace }}
  opensearch:
    type: {{ .SecOps.Backup.SnapshotRepositoryType }}
{{- if .SecOps.Backup.SnapshotFS }}
    fs:
      # The releases' wazuh indexer.snapshot.fs.path, which is their path.repo.
      location: {{ .SecOps.Backup.SnapshotVolumePath }}
{{- end }}
    retentionDays: {{ .SecOps.Backup.RetentionDays }}
{{- if .SecOps.Profile.IndexShardReplicas }}
    # Every shard of the alert indices gets a copy on another indexer node.
    numberOfReplicas: {{ .SecOps.Profile.IndexShardReplicas }}
{{- end }}
  verifyRestore:
    enabled: {{ .SecOps.Backup.VerifyRestore }}
{{- end }}

reconciler:
  enabled: {{ .SecOps.ReconcilerEnabled }}
  {{- if or .SecOps.ReconcilerImageRepository .SecOps.ReconcilerImageTag }}
  image:
    {{- if .SecOps.ReconcilerImageRepository }}
    repository: {{ .SecOps.ReconcilerImageRepository }}
    {{- end }}
    {{- if .SecOps.ReconcilerImageTag }}
    tag: {{ .SecOps.ReconcilerImageTag }}
    {{- end }}
  {{- end }}
  {{- with .SecOps.ReconcilerImagePullSecrets }}
  imagePullSecrets:
    {{- range . }}
    - name: {{ . }}
    {{- end }}
  {{- end }}
  dryRun: {{ .SecOps.ReconcilerDryRun }}
{{- if .SecOps.KeycloakHostAliasIP }}
  hostAliases:
    - ip: {{ .SecOps.KeycloakHostAliasIP }}
      hostnames: [{{ .SecOps.KeycloakHost }}]
{{- end }}

# Central Wazuh search: indexer + dashboard, no manager.
wazuh:
  wazuh:
    # Config checksums on the pods, so a config change restarts them.
    autoreload:
      enabled: true
    indexer:
{{- if .SecOps.Profile.HA }}
      # The central indexer holds no events, only the Wazuh app's own saved
      # objects, but the dashboard is unusable without it.
      replicas: {{ .SecOps.Profile.IndexerNodes }}
      pdb:
        enabled: true
        minAvailable: {{ .SecOps.Profile.IndexerMinAvailable }}
{{- end }}
{{- if or .SecOps.KeycloakHostAliasIP .SecOps.Profile.HA }}
      extraSpec:
        pod:
{{- if .SecOps.KeycloakHostAliasIP }}
          hostAliases:
            - ip: {{ .SecOps.KeycloakHostAliasIP }}
              hostnames: [{{ .SecOps.KeycloakHost }}]
{{- end }}
{{- if .SecOps.Profile.HA }}
          topologySpreadConstraints:
            - maxSkew: 1
              topologyKey: {{ .SecOps.Profile.TopologyKey }}
              whenUnsatisfiable: DoNotSchedule
              labelSelector:
                matchLabels:
                  app: wazuh-indexer
{{- end }}
{{- end }}
      cred:
        existingSecret: wazuh-indexer-cred
        passwordHash: "{{ .SecOps.CentralIndexerPasswordHash }}"
      networkPolicy:
        # Lists replace the chart defaults: the first entry of each is the
        # security-operations default, the Keycloak one is added.
        extraEgresses:
          # Cross-cluster search to the tenant indexers.
          - ports:
              - protocol: TCP
                port: 9300
            to:
              - namespaceSelector:
                  matchExpressions:
                    - key: security-operations.kubeaid.io/tenant
                      operator: Exists
                podSelector:
                  matchLabels:
                    app: wazuh-indexer
          # OIDC discovery and keys from Keycloak, behind the ingress controller.
          - ports:
              - protocol: TCP
                port: 443
              - protocol: TCP
                port: 8443
            to:
              - namespaceSelector:
                  matchLabels:
                    kubernetes.io/metadata.name: traefik
        extraIngresses:
          # The reconciler sets the remote clusters through the REST API.
          - ports:
              - protocol: TCP
                port: 9200
            from:
              - podSelector:
                  matchLabels:
                    app.kubernetes.io/name: siem-reconciler
    dashboard:
{{- if .SecOps.Profile.HA }}
      replicas: {{ .SecOps.Profile.DashboardReplicas }}
      pdb:
        enabled: true
        minAvailable: 1
{{- end }}
{{- if or .SecOps.KeycloakHostAliasIP .SecOps.Profile.HA }}
      extraSpec:
        pod:
{{- if .SecOps.KeycloakHostAliasIP }}
          hostAliases:
            - ip: {{ .SecOps.KeycloakHostAliasIP }}
              hostnames: [{{ .SecOps.KeycloakHost }}]
{{- end }}
{{- if .SecOps.Profile.HA }}
          topologySpreadConstraints:
            - maxSkew: 1
              topologyKey: {{ .SecOps.Profile.TopologyKey }}
              whenUnsatisfiable: ScheduleAnyway
              labelSelector:
                matchLabels:
                  app: wazuh-dashboard
{{- end }}
{{- end }}
      cred:
        existingSecret: wazuh-dashboard-cred
        passwordHash: "{{ .SecOps.CentralDashboardPasswordHash }}"
      ingress:
        enabled: true
        className: {{ .SecOps.IngressClassName }}
        host: {{ .SecOps.WazuhHost }}
        annotations:
          cert-manager.io/cluster-issuer: {{ .SecOps.ClusterIssuer }}
        tls:
          - hosts:
              - {{ .SecOps.WazuhHost }}
            secretName: wazuh-tls
      # Keycloak SSO, client wazuh-dashboard. The reconciler creates the client
      # and Secret wazuh-dashboard-oidc (client id, secret, cookie password).
      sso:
        oidc:
          enabled: true
          # Discovery is a back-channel call; the issuer below stays public.
          url: {{ .SecOps.KeycloakDiscoveryURL }}
          logoutUrl: {{ .SecOps.KeycloakIssuer }}/protocol/openid-connect/logout
          issuer: {{ .SecOps.KeycloakIssuer }}
          scope: "openid profile email"
          existingSecret: wazuh-dashboard-oidc
          config:
            subjectKey: preferred_username
            rolesKey: roles
          roleMappings:
            allAccess:
              backendRoles:
                - {{ .SecOps.AdminRole }}
            readall:
              backendRoles:
                - {{ .SecOps.AnalystRole }}
            kibanaUser:
              backendRoles:
                - {{ .SecOps.AnalystRole }}
          customizeLoginButton:
            enabled: true
            text: "Log in with SSO"
      # Login through Keycloak only; securityOperations.dashboardBreakGlass adds
      # the username/password form (internal admin) next to the SSO button.
      # Basic auth stays first on the indexer without a challenge, so service
      # logins never touch OIDC.
      basicAuth:
        enabled: true
        breakGlass: {{ .SecOps.DashboardBreakGlass }}
        order: 0
        challenge: false
      # The default cookie password is public.
      additionalEnv:
        - name: OPENSEARCH_COOKIE_PASSWORD
          valueFrom:
            secretKeyRef:
              name: wazuh-dashboard-oidc
              key: OPENSEARCH_COOKIE_PASSWORD
      server:
        extraConf:
          opensearch_security.cookie.password: ${OPENSEARCH_COOKIE_PASSWORD}
          opensearch_security.cookie.secure: true
      networkPolicy:
        extraEgresses:
          # The Wazuh app calls every tenant's manager API.
          - ports:
              - protocol: TCP
                port: 55000
            to:
              - namespaceSelector:
                  matchExpressions:
                    - key: security-operations.kubeaid.io/tenant
                      operator: Exists
          # OIDC token exchange with Keycloak, behind the ingress controller.
          - ports:
              - protocol: TCP
                port: 443
              - protocol: TCP
                port: 8443
            to:
              - namespaceSelector:
                  matchLabels:
                    kubernetes.io/metadata.name: traefik

velociraptor:
{{- with .SecOps.VelociraptorEntryPoint }}
  # Clients speak mTLS to the frontend and pin its certificate: Traefik forwards
  # the raw TLS by SNI on this entry point (a public hostPort, 8000).
  frontendTcpRoute:
    enabled: true
    entryPoint: {{ . }}
    host: {{ $.SecOps.VelociraptorHost }}
  frontendAllowedFrom:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: traefik
{{- end }}
  velociraptor:
{{- if .SecOps.KeycloakHostAliasIP }}
    hostAliases:
      - ip: {{ .SecOps.KeycloakHostAliasIP }}
        hostnames: [{{ .SecOps.KeycloakHost }}]
{{- end }}
{{- if .SecOps.ReconcilerEnabled }}
    # Mints the reconciler's Velociraptor API client before the server starts and
    # stores it in Secret velociraptor-api-client; the publisher init container
    # runs the reconciler image (the chart checks that both match).
    apiClient:
      enabled: true
      publisherImage:
        repository: {{ .SecOps.ReconcilerImage }}
        tag: {{ .SecOps.ReconcilerImageTag }}
      {{- with .SecOps.ReconcilerImagePullSecrets }}
      imagePullSecrets:
        {{- range . }}
        - name: {{ . }}
        {{- end }}
      {{- end }}
{{- end }}
{{- if .SecOps.ContentEnabled }}
    # The reconciler sets the artifacts (kubesoc-content); artifacts loaded from
    # this mount would be built in and could not be replaced.
    customArtifacts:
      enabled: false
{{- end }}
    gui:
      publicUrl: https://{{ .SecOps.VelociraptorHost }}/app/index.html
      ingress:
        enabled: true
        className: {{ .SecOps.IngressClassName }}
        annotations:
          cert-manager.io/cluster-issuer: {{ .SecOps.ClusterIssuer }}
        hosts:
          - host: {{ .SecOps.VelociraptorHost }}
            paths:
              - path: /
                pathType: Prefix
        tls:
          - secretName: velociraptor-tls
            hosts:
              - {{ .SecOps.VelociraptorHost }}
      # Keycloak SSO, client velociraptor (callback /auth/oidc/keycloak/callback).
      oidc:
        enabled: true
        name: keycloak
        issuer: {{ .SecOps.KeycloakIssuer }}
        clientId: velociraptor
        existingSecret: velociraptor-oidc
        existingSecretKey: oauth_client_secret
{{- if .SecOps.Profile.HA }}
    # Velociraptor's metadata datastore has a single writer, so the frontend
    # stays at one replica; the budget keeps a drain from taking it silently.
    podDisruptionBudget:
      enabled: true
      minAvailable: 1
{{- end }}
    networkPolicy:
      # The ingress controller reaches the GUI.
      guiAllowedFrom:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: traefik
      # OIDC: Cilium does not match pods by CIDR, so the chart's ipBlock rule does
      # not reach Keycloak behind the ingress controller; allow its pods instead.
      oidcEgressCIDRs: []
      # Replaces the chart's list, so the IRIS rule is repeated here.
      extraEgress:
        - to:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: traefik
          ports:
            - protocol: TCP
              port: 443
            - protocol: TCP
              port: 8443
        # Server artifacts poll the IRIS API.
        - to:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/name: dfir-iris
                  app.kubernetes.io/component: app
          ports:
            - protocol: TCP
              port: 8000

dfir-iris:
{{- with .SecOps.SharedStorageClass }}
  # ReadWriteMany, so the IRIS app and worker may run on different nodes.
  persistence:
    storageClass: {{ . }}
    accessModes: [ReadWriteMany]
{{- end }}
{{- if .SecOps.Profile.HA }}
  app:
    replicas: {{ .SecOps.Profile.IRISAppReplicas }}
  worker:
    replicas: {{ .SecOps.Profile.IRISWorkerReplicas }}
  topologySpreadTopologyKey: {{ .SecOps.Profile.TopologyKey }}
{{- if .SecOps.SharedStorageClass }}
  # The volume is ReadWriteMany, so a rolling update no longer deadlocks on
  # Multi-Attach and an upgrade stops being an outage.
  strategy:
    type: RollingUpdate
{{- end }}
{{- end }}
{{- if or .SecOps.Profile.HA .SecOps.Backup.Enabled }}
  global:
    postgresql:
{{- if .SecOps.Profile.HA }}
      instances: {{ .SecOps.Profile.DatabaseInstances }}
      topologyKey: {{ .SecOps.Profile.TopologyKey }}
{{- end }}
{{- if .SecOps.Backup.Enabled }}
      # CloudNativePG archives its WAL to the object store next to the base
      # backups, so a restore can roll forward rather than only to the last one.
      # The pods carry velero.io/exclude-from-backup: their volumes are barman's.
      backups:
        enabled: true
        cloud: aws
        destinationPath: {{ .SecOps.Backup.PostgresDestination }}
        endpointURL: {{ .SecOps.Backup.Endpoint | printf "%q" }}
        secretName: {{ .SecOps.Backup.CredentialsSecret }}
        retentionPolicy: {{ .SecOps.Backup.RetentionDays }}d
{{- end }}
{{- if .SecOps.Profile.HA }}
    rabbitmq:
      replicas: {{ .SecOps.Profile.DatabaseInstances }}
{{- end }}
{{- end }}
{{- if .SecOps.KeycloakHostAliasIP }}
  hostAliases:
    - ip: {{ .SecOps.KeycloakHostAliasIP }}
      hostnames: [{{ .SecOps.KeycloakHost }}]
{{- end }}
  ingress:
    enabled: true
    className: {{ .SecOps.IngressClassName }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .SecOps.ClusterIssuer }}
    host: {{ .SecOps.IRISHost }}
    tls:
      - secretName: iris-tls
        hosts:
          - {{ .SecOps.IRISHost }}
  # Keycloak SSO, client iris (redirect /oidc-authorize). No local password form:
  # set localFallback: true in the cluster's own values only for a planned
  # break-glass login as the IRIS administrator. SSO users are matched on their
  # Keycloak user id (sub), so an IdP user named like a local login cannot sign
  # in as it; keycloakSync creates and renames users to that id.
  authentication:
    type: oidc
    localFallback: false
    createUserIfNotExist: true
    oidc:
      issuerUrl: {{ .SecOps.KeycloakIssuer }}
      clientId: iris
      existingSecret: dfir-iris-oidc
      mappingUsername: sub
  # Keycloak -> IRIS access: IRIS ignores roles in the OIDC token, so this job
  # gives each SSO user the IRIS groups and customers of its realm roles and
  # tenant groups (mapping from the umbrella's dfir-iris-tenants ConfigMap).
  # Secret iris-keycloak-sync: the iris-sync client secret and the IRIS API key.
  keycloakSync:
    enabled: true
    dryRun: false
    keycloak:
      url: {{ .SecOps.KeycloakURL }}
      realm: {{ .SecOps.KeycloakRealm }}
      clientId: iris-sync
    existingSecret: iris-keycloak-sync
  # Alert triage by the in-cluster model; the reconciler keeps the svc_ai key
  # in Secret iris-ai-triage.
  aiTriage:
    enabled: {{ .SecOps.AITriageEnabled }}
    dryRun: {{ .SecOps.AITriageDryRun }}
    model: {{ .SecOps.AIModel | quote }}
{{- if .SecOps.AIDownloadModel }}

# Temporary: HTTPS egress so Ollama can pull the model onto its volume. Set
# securityOperations.aiTriage.downloadModel back to false once it is there.
ollama:
  ollama:
    ollama:
      models:
        pull: [{{ .SecOps.AIModel | quote }}]
  networkPolicy:
    allowModelDownload: true
{{- end }}

misp:
{{- if or .SecOps.Profile.HA .SecOps.Backup.Enabled }}
  externalMariadb:
{{- if .SecOps.Profile.HA }}
    replicas: {{ .SecOps.Profile.DatabaseInstances }}
    topologyKey: {{ .SecOps.Profile.TopologyKey }}
{{- end }}
{{- if .SecOps.Backup.Enabled }}
    # The attachments are not in the dump; Velero copies that volume.
    backup:
      enabled: true
      maxRetention: {{ .SecOps.Backup.MariaDBMaxRetention }}
      storage:
        type: S3
        s3:
          bucket: {{ .SecOps.Backup.Bucket }}
          prefix: {{ .SecOps.Backup.BasePath }}/misp-mariadb
          # mariadb-operator takes a host and port, not a URL.
          endpoint: {{ .SecOps.Backup.MariaDBEndpoint }}
          region: {{ .SecOps.Backup.Region }}
          tls: {{ .SecOps.Backup.MariaDBTLS }}
          credentialsSecret: {{ .SecOps.Backup.CredentialsSecret }}
{{- end }}
{{- end }}
  misp:
{{- if .SecOps.KeycloakHostAliasIP }}
    hostAliases:
      - ip: {{ .SecOps.KeycloakHostAliasIP }}
        hostnames: [{{ .SecOps.KeycloakHost }}]
{{- end }}
    instanceEnv:
      mispBaseurl: https://{{ .SecOps.MISPHost }}
      ingressHostName: {{ .SecOps.MISPHost }}
    env:
      # Keycloak SSO, client misp; client id and secret in Secret
      # oidc-credentials. Realm roles arrive in the "roles" claim.
      oidcEnable: true
      oidcProviderUrl: {{ .SecOps.KeycloakIssuer }}
      oidcRolesProperty: roles
      oidcRolesMapping: '{"{{ .SecOps.AdminRole }}": "admin", "{{ .SecOps.AnalystRole }}": "User"}'
      oidcDefaultOrg: "1"
      oidcLogoutUrl: {{ .SecOps.KeycloakIssuer }}/protocol/openid-connect/logout?client_id=misp
      oidcScopes: '["openid", "email", "profile"]'
      # Valkey password from the Secret kubeaid-cli seals once
      # (sealed-secrets/security-operations/misp-redis.yaml); valkey reads the
      # same Secret below.
      redisPasswordSecret:
        name: misp-redis
        key: password
    misp:
      ingress:
        enabled: true
        className: {{ .SecOps.IngressClassName }}
        annotations:
          kubernetes.io/ingress.class: {{ .SecOps.IngressClassName }}
          cert-manager.io/cluster-issuer: {{ .SecOps.ClusterIssuer }}
    tls:
      useTLS: true
    valkey:
      auth:
        usersExistingSecret: misp-redis
        aclUsers:
          default:
            passwordKey: password
            # No inline password next to the Secret (the wrapper's default).
            password: ""
  wazuhCdbExport:
    # Every 15 minutes MISP's indicators become three CDB lists on every tenant
    # manager, which registers them and re-points Wazuh's IoC rules 99901-99920
    # at them (values-wazuh-tenant.yaml, security-operations.yaml). The
    # credentials Secrets are copied from the tenant namespaces by the reconciler.
    # The managers' API certificates come from the soc-ca (managerTls in
    # values-wazuh-tenant.yaml) and are verified (the chart's caSecret).
    enabled: true
    targets:
{{- range .SecOps.Tenants }}
      - name: "{{ .Code }}"
        url: https://wazuh.{{ .Namespace }}.svc:55000
        credentialsSecret: wazuh-api-cred-{{ .Code }}
{{- else }} []
{{- end }}
{{- if .SecOps.ContentEnabled }}

# Detection content as code (KubeAid kubesoc-content): the reconciler rolls the
# package out to every tenant manager, the canary first, and sets the
# Velociraptor artifacts.
kubesoc-content:
  enabled: true
  {{- with .SecOps.ContentCanary }}
  canary: "{{ . }}"
  {{- end }}
{{- end }}
