# Rendered by kubeaid-cli from cluster.securityOperations in general.yaml. Shared
# values of every tenant's Wazuh (KubeAid argocd-helm-charts/kubesoc/wazuh, README
# section 11; mirrors tests/values-tenant.yaml there). The per-tenant part
# (certificate organization, IRIS customer, replicas, password hashes, host,
# agent ports, role mappings) is the valuesObject of each wazuh-<code>
# Application in templates/security-operations.yaml.
irisIntegration:
  enabled: true
# Default deny in the tenant namespace and the SOC flows (wazuh chart
# templates/networkpolicies.yaml): manager API from the central reconciler, MISP
# export and dashboard only; agents on 1514/1515; indexer 9300 from the central
# indexer; dashboard from the ingress controller; Keycloak for OIDC; the CTI feed.
networkPolicies:
  enabled: true
wazuh:
  fullnameOverride: wazuh
  # Config checksums on the pods, so a config change (e.g. extraNodesDn) restarts them.
  autoreload:
    enabled: true
  # Cluster nodes are not a tenant's endpoints.
  agent:
    enabled: false
  certificates:
    # Shared CA (security-operations socCA), so the indexers trust each other.
    issuer:
      name: soc-ca
      type: ClusterIssuer
  indexer:
{{- if or .SecOps.KeycloakHostAliasIP .SecOps.Profile.HA }}
    extraSpec:
      pod:
{{- if .SecOps.KeycloakHostAliasIP }}
        hostAliases:
          - ip: {{ .SecOps.KeycloakHostAliasIP }}
            hostnames: [{{ .SecOps.KeycloakHost }}]
{{- end }}
{{- if .SecOps.Profile.HA }}
        # Three indexer nodes are only resilience when they are not on one
        # node (or in one zone, with topologyKey set to the zone label).
        topologySpreadConstraints:
          - maxSkew: 1
            topologyKey: {{ .SecOps.Profile.TopologyKey }}
            whenUnsatisfiable: DoNotSchedule
            labelSelector:
              matchLabels:
                app: wazuh-indexer
{{- end }}
{{- end }}
{{- if .SecOps.Profile.HA }}
    pdb:
      enabled: true
      # A quorum, so a drain cannot take the cluster below two data nodes.
      minAvailable: {{ .SecOps.Profile.IndexerMinAvailable }}
{{- end }}
{{- if and .SecOps.Backup.Enabled .SecOps.Backup.SnapshotFS }}
    # The OpenSearch snapshot repository: one volume every indexer node mounts,
    # which is also what sets path.repo (without it the indexer refuses the
    # repository). The security-operations chart's snapshot CronJob registers it.
    snapshot:
      enabled: true
      fs:
        path: {{ .SecOps.Backup.SnapshotVolumePath }}
        storageSize: {{ .SecOps.Backup.SnapshotVolumeSize }}
        storageClass: {{ .SecOps.Backup.SnapshotStorageClass }}
{{- end }}
    cred:
      existingSecret: wazuh-indexer-cred
    config:
      # The central search indexer may connect as a node (cross-cluster search).
      # The static nodes_dn list: nodes_dn.yml is not read by default.
      extraNodesDn:
        - "{{ .SecOps.CentralIndexerDN }}"
{{- if .SecOps.Profile.HA }}
      # Shard allocation awareness: a shard and its copy never land on the same
      # node.attr.zone. The attribute is the pod's node, which with the spread
      # above is one per failure domain.
      extraOpensearch:
        cluster.routing.allocation.awareness.attributes: zone
        node.attr.zone: ${NODE_ZONE}
    additionalEnv:
      - name: NODE_ZONE
        valueFrom:
          fieldRef:
            fieldPath: spec.nodeName
{{- end }}
  dashboard:
    # Verify the indexer's certificate (soc-ca, named wazuh-indexer).
    opensearchVerificationMode: full
{{- if .SecOps.Profile.HA }}
    replicas: {{ .SecOps.Profile.DashboardReplicas }}
    pdb:
      enabled: true
      minAvailable: 1
{{- end }}
{{- if or .SecOps.KeycloakHostAliasIP .SecOps.Profile.HA }}
    extraSpec:
      pod:
{{- if .SecOps.KeycloakHostAliasIP }}
        hostAliases:
          - ip: {{ .SecOps.KeycloakHostAliasIP }}
            hostnames: [{{ .SecOps.KeycloakHost }}]
{{- end }}
{{- if .SecOps.Profile.HA }}
        topologySpreadConstraints:
          - maxSkew: 1
            topologyKey: {{ .SecOps.Profile.TopologyKey }}
            whenUnsatisfiable: ScheduleAnyway
            labelSelector:
              matchLabels:
                app: wazuh-dashboard
{{- end }}
{{- end }}
    cred:
      existingSecret: wazuh-dashboard-cred
    ingress:
      enabled: true
      className: {{ .SecOps.IngressClassName }}
      annotations:
        cert-manager.io/cluster-issuer: {{ .SecOps.ClusterIssuer }}
    # Keycloak SSO, client wazuh-dashboard-<code>. The reconciler creates the
    # client and Secret wazuh-dashboard-oidc in the tenant namespace (client
    # id, secret, cookie password). Role mappings are per tenant.
    sso:
      oidc:
        enabled: true
        # Discovery is a back-channel call: the pods may fetch it from the
        # Keycloak Service, while the issuer below stays the browser-facing one.
        url: {{ .SecOps.KeycloakDiscoveryURL }}
        logoutUrl: {{ .SecOps.KeycloakIssuer }}/protocol/openid-connect/logout
        issuer: {{ .SecOps.KeycloakIssuer }}
        scope: "openid profile email"
        existingSecret: wazuh-dashboard-oidc
        config:
          subjectKey: preferred_username
          rolesKey: roles
        customizeLoginButton:
          enabled: true
          text: "Log in with SSO"
    # Login through Keycloak only; securityOperations.dashboardBreakGlass adds
    # the username/password form (internal admin) next to the SSO button.
    basicAuth:
      enabled: true
      breakGlass: {{ .SecOps.DashboardBreakGlass }}
      order: 0
      challenge: false
    # The default cookie password is public.
    additionalEnv:
      - name: OPENSEARCH_COOKIE_PASSWORD
        valueFrom:
          secretKeyRef:
            name: wazuh-dashboard-oidc
            key: OPENSEARCH_COOKIE_PASSWORD
    server:
      extraConf:
        opensearch_security.cookie.password: ${OPENSEARCH_COOKIE_PASSWORD}
        opensearch_security.cookie.secure: true
    networkPolicy:
      # Not open to any source: networkPolicies admits the ingress controller.
      ingressFrom: []
  wazuh:
{{- if .SecOps.ContentEnabled }}
    # Detection content: the rules (the IoC pack 99901-99920 included) come from
    # the KubeAid kubesoc-content package, uploaded by the siem-reconciler. The
    # MISP-fed lists (and the package's static ones) are registered in the stock
    # <ruleset>, and the stock IoC file is excluded so those ids are defined once.
    ruleset:
      extraLists:
{{- range .SecOps.ContentLists }}
        - {{ . }}
{{- end }}
      extraRuleExcludes:
        - 0999-malicious-ioc-rules.xml
{{- else }}
    # MISP indicators: Wazuh 4.14's own IoC rule pack
    # (ruleset/rules/0999-malicious-ioc-rules.xml, rules 99901-99920) re-pointed at
    # the flat lists the MISP export writes; the stock file is excluded in the
    # manager's <ruleset>, so these ids are defined once. Same rules, fields and
    # levels; regenerate with the sed recipe in the misp chart README (section 5)
    # rather than editing. Replaces the chart's sample local_rules.xml.
    localRules: |
        <!-- Wazuh's 0999-malicious-ioc-rules.xml re-pointed at the MISP-fed lists.
             Generated; see argocd-helm-charts/kubesoc/misp/README.md section 5. -->
        <group name="malware,">

          <rule id="99901" level="14">
            <!-- The if_sid tag references the built-in FIM rules -->
            <if_sid>554, 550</if_sid>
            <list field="sha256" lookup="match_key">etc/lists/misp-malware-hashes</list>
            <description>FIM: File with known malware hash detected: $(file).</description>
            <mitre>
              <id>T1204.002</id>
            </mitre>
          </rule>

        </group>

        <group name="WAF, Cloudflare">

          <rule id="99902" level="9">
            <if_sid>92501</if_sid>
            <list field="ClientIP" lookup="match_key">etc/lists/misp-malicious-ip</list>
            <description>Cloudflare WAF: Connection from malicious IP $(ClientIP) detected.</description>
          </rule>

        </group>

        <group name="syslog,sshd,">

          <rule id="99903" level="14">
            <if_sid>5715</if_sid>
            <list field="srcip" lookup="match_key">etc/lists/misp-malicious-ip</list>
            <description>sshd: Authentication succeeded from a malicious IP address $(srcip).</description>
            <group>authentication_failed,authentication_success,pci_dss_10.2.4,pci_dss_10.2.5,</group>
          </rule>

          <rule id="99904" level="9">
            <if_sid>5716</if_sid>
          <list field="srcip" lookup="match_key">etc/lists/misp-malicious-ip</list>
            <description>sshd: Authentication failed from a malicious IP address $(srcip).</description>
            <group>authentication_failed,authentication_success,pci_dss_10.2.4,pci_dss_10.2.5,</group>
          </rule>
        </group>

        <group name="web,accesslog,">

          <rule id="99905" level="9">
            <if_sid>31103, 31104, 31105, 31106, 31109, 31164, 31165, 31170, 31171</if_sid>
            <list field="srcip" lookup="match_key">etc/lists/misp-malicious-ip</list>
            <description>Common web attack from malicious IP $(srcip) detected.</description>
          </rule>

          <rule id="99906" level="14">
            <if_sid>99905</if_sid>
            <id>^200</id>
            <description>A web attack from malicious IP  $(srcip) returned code 200 (success).</description>
          </rule>

        </group>

        <group name="apache,web,">

          <rule id="99907" level="9">
            <if_sid>30108, 30109, 30110</if_sid>
            <list field="srcip" lookup="match_key">etc/lists/misp-malicious-ip</list>
            <description>Apache: User authentication from malicious IP $(srcip) failed.</description>
          </rule>

          <rule id="99908" level="9">
            <if_sid>30105, 30106, 30112</if_sid>
            <list field="srcip" lookup="match_key">etc/lists/misp-malicious-ip</list>
            <description>Apache: Attempt to access forbidden or non-existent file or directory from malicious IP $(srcip) detected.</description>
          </rule>

        </group>

        <group name="macOS,">

          <rule id="99909" level="9">
            <if_sid>89606</if_sid>
            <list field="ip_address" lookup="match_key">etc/lists/misp-malicious-ip</list>
            <description>Attempt to connect to screen sharing with username $(dstuser) from malicious IP $(ip_address) failed.</description>
            <mitre>
              <id>T1021</id>
              <id>T1078</id>
            </mitre>
            <group>authentication_failed,gdpr_IV_35.7.d,gdpr_IV_32.2,gpg13_7.1,hipaa_164.312.b,invalid_login,nist_800_53_AU.14,nist_800_53_AC.7,nist_800_53_AU.6,pci_dss_10.2.4,pci_dss_10.2.5,pci_dss_10.6.1,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
          </rule>

          <rule id="99910" level="14">
            <if_sid>89607</if_sid>
            <list field="ip_address" lookup="match_key">etc/lists/misp-malicious-ip</list>
            <description>Attempt to connect to screen sharing with username $(dstuser) from malicious IP $(ip_address) succeeded.</description>
            <mitre>
              <id>T1021</id>
              <id>T1078</id>
            </mitre>
            <group>authentication_success,gdpr_IV_32.2,gpg13_7.1,gpg13_7.2,hipaa_164.312.b,nist_800_53_AC.7,nist_800_53_AU.14,pci_dss_10.2.5,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
          </rule>

        </group>


        <group name="dovecot,">

          <rule id="99911" level="9">
            <if_sid>9702, 9705, 9771</if_sid>
            <list field="srcip" lookup="match_key">etc/lists/misp-malicious-ip</list>
            <description>Dovecot authentication from malicious IP $(srcip) failed.</description>
            <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,gpg13_7.1,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
          </rule>

          <rule id="99912" level="14">
            <if_sid>9701</if_sid>
            <list field="srcip" lookup="match_key">etc/lists/misp-malicious-ip</list>
             <description>Dovecot authentication from malicious IP $(srcip) was successful.</description>
            <mitre>
              <id>T1078</id>
            </mitre>
            <group>authentication_success,pci_dss_10.2.5,gpg13_7.1,gpg13_7.2,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
          </rule>

        </group>

        <group name="sqlserver,">

            <rule id="99913" level="14">
                <if_sid>85004</if_sid>
                <list field="srcip" lookup="match_key">etc/lists/misp-malicious-ip</list>
                <description>SQL server login from malicious IP $(srcip) was successful.</description>
                <group>sqlserver_login,pci_dss_10.2.5,gpg13_7.1,gpg13_7.2,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
            </rule>

            <rule id="99914" level="9">
                <if_sid>85005</if_sid>
                <list field="srcip" lookup="match_key">etc/lists/misp-malicious-ip</list>
                <description>SQL server login from malicious IP $(srcip) failed.</description>
                <group>sqlserver_login, authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,gpg13_7.1,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
            </rule>

        </group>

        <group name="ids,suricata,">

            <rule id="99915" level="9">
                <if_sid>86601</if_sid>
                <list field="src_ip" lookup="match_key">etc/lists/misp-malicious-ip</list>
                <description>Suricata: Alert from malicious IP $(src_ip).</description>
            </rule>

            <rule id="99916" level="9">
                <if_sid>86601</if_sid>
                <list field="dest_ip" lookup="match_key">etc/lists/misp-malicious-ip</list>
                <description>Suricata: Alert from malicious IP $(dest_ip).</description>
            </rule>

            <rule id="99917" level="9">
                <if_sid>86601, 86602</if_sid>
                <list field="http.hostname" lookup="match_key">etc/lists/misp-malicious-domains</list>
                <description>Suricata: Alert from malicious domain $(http.hostname).</description>
            </rule>

            <rule id="99918" level="9">
                <if_sid>86601, 86602, 86603</if_sid>
                <list field="dns.rrname" lookup="match_key">etc/lists/misp-malicious-domains</list>
                <description>Suricata: Alert from malicious domain $(dns.rrname).</description>
            </rule>

        </group>

        <group name="windows,windows_security,">

          <rule id="99919" level="9">
            <if_sid>60105, 60122</if_sid>
            <list field="win.eventdata.ipAddress" lookup="match_key">etc/lists/misp-malicious-ip</list>
            <description>Failed logon from malicious IP $(win.eventdata.ipAddress).</description>
            <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,gpg13_7.1,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
            <mitre>
              <id>T1078</id>
            </mitre>
          </rule>

          <rule id="99920" level="14">
            <if_sid>92651</if_sid>
            <list field="win.eventdata.ipAddress" lookup="match_key">etc/lists/misp-malicious-ip</list>
            <description>Successful remote logon from malicious IP $(win.eventdata.ipAddress).</description>
            <group>authentication_success,pci_dss_10.2.5,gpg13_7.1,gpg13_7.2,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
            <mitre>
              <id>T1078</id>
            </mitre>
          </rule>

        </group>
{{- end }}
    apiCred:
      existingSecret: wazuh-api-cred
    authd:
      existingSecret: wazuh-authd-pass
    # Cluster key from the sealed Secret kubeaid-cli writes per tenant, so it is
    # neither in the Application nor in the manager ConfigMap.
    clusterKeySecret:
      name: wazuh-manager-cluster-key
    # API (55000) and authd (1515) certificate from the soc-ca instead of the image's
    # self-signed ones: the reconciler and the MISP export verify the API, and agents
    # verify authd with the CA from the enrolment bundle, by the host they dial.
    managerTls:
      enabled: true
{{- if .SecOps.AgentHost }}
      extraDnsNames:
        - {{ .SecOps.AgentHost }}
{{- end }}
{{- if .SecOps.Profile.ManagerWorkers }}
    # Workers take the agents' events while the master keeps enrolment, the API
    # and the rule set, so a master restart is not an outage for the agents.
    worker:
      enabled: true
      replicas: {{ .SecOps.Profile.ManagerWorkers }}
      podAntiAffinity: hard
      podAntiAffinityTopologyKey: {{ .SecOps.Profile.TopologyKey }}
      pdb:
        enabled: true
        minAvailable: 1
{{- else }}
    # Master only: one manager takes a few thousand agents.
    worker:
      enabled: false
{{- end }}
    master:
{{- if .SecOps.Profile.HA }}
      # The master is a single pod: agents cannot enrol and the rule set cannot
      # be distributed without it. minAvailable 1 on one replica refuses
      # voluntary eviction outright, which is the point - draining that node is
      # then a decision someone makes (kubectl drain --disable-eviction), not
      # something that happens during unattended maintenance.
      pdb:
        enabled: true
        minAvailable: 1
{{- end }}
      service:
        ports:
          - name: registration
            protocol: TCP
            port: 1515
            targetPort: 1515
          - name: api
            protocol: TCP
            port: 55000
            targetPort: 55000
          - name: agents-events
            protocol: TCP
            port: 1514
            targetPort: 1514
      additionalVolumes:
        - name: iris-integration
          configMap:
            name: wazuh-iris-integration
            defaultMode: 0755
        # IRIS API key (key API_KEY) of this tenant's own IRIS service account, kept
        # in the tenant namespace by the security-operations reconciler (tenantIris).
        - name: iris-api-key
          secret:
            secretName: iris-api-key
            optional: true
            defaultMode: 0444
      additionalVolumeMounts:
        - name: iris-integration
          mountPath: /var/ossec/integrations/custom-iris
          subPath: custom-iris
          readOnly: true
        - name: iris-integration
          mountPath: /var/ossec/integrations/custom-iris.py
          subPath: custom-iris.py
          readOnly: true
        # A directory mount, not subPath: a subPath of a Secret that does not
        # exist yet becomes an empty directory for the pod's lifetime, while a
        # directory mount picks the key up when the reconciler copies it.
        - name: iris-api-key
          mountPath: /var/ossec/integrations/iris
          readOnly: true
      networkPolicy:
        # HTTPS to the internet only (networkPolicies.cti), not to any address.
        ctiEgress: false
