apiVersion: kubeone.k8c.io/v1beta2
kind: KubeOneCluster

name: {{ .ClusterConfig.Name }}

cloudProvider:
  none: {}

versions:
  kubernetes: {{ .K8sVersion }}

apiEndpoint: {{- .BareMetalConfig.ControlPlane.Endpoint | toIndentYAML 2 | nindent 2 }}

controlPlane:
  hosts:
  {{- range $hostIndex, $host := .BareMetalConfig.ControlPlane.Hosts }}
    - {{- if and ($host.SSH) ($host.SSH.Port) }}
      sshPort: {{ $host.SSH.Port }}
      {{- else }}
      sshPort: {{ $.BareMetalConfig.SSH.Port }}
      {{- end }}

      {{- if and ($host.SSH) ($host.SSH.SSHKeyPairConfig) }}
      sshPrivateKeyFile: {{ $host.SSH.PrivateKeyFilePath }}
      {{- else if and ($.BareMetalConfig.SSH) ($.BareMetalConfig.SSH.SSHKeyPairConfig) }}
      sshPrivateKeyFile: {{ $.BareMetalConfig.SSH.PrivateKeyFilePath }}
      {{- end }}

      {{- if $host.PublicAddress }}
      publicAddress: {{ $host.PublicAddress }}
      {{- end }}
      {{- if $host.PrivateAddress }}
      privateAddress: {{ $host.PrivateAddress }}
      {{- end }}
      {{- if $.BareMetalConfig.Kubelet }}
      kubelet: {{- $.BareMetalConfig.Kubelet | toIndentYAML 2 | nindent 8 }}
      {{- end }}
  {{- end }}

# kube-scheduler and kube-controller-manager default to --bind-address=127.0.0.1,
# which leaves their /metrics reachable only from the node itself - Prometheus
# runs in a Pod, so both targets are permanently down (KubeSchedulerInstance-
# Unreachable / KubeControllerManagerInstanceUnreachable, which is what
# kube-prometheus alerts on).
#
# Setting bind-address: 0.0.0.0 here "fixes" the alert but puts the real
# components on every interface the node has, including the public one -
# CIS Kubernetes Benchmark 1.3.7/1.4.2 call this out explicitly, and
# kubernetes/kubeadm#2202 tracks it as an open, unresolved exposure upstream.
# Both components stay on 127.0.0.1 by design; Prometheus reaches them
# through the haproxy chart (argocd-helm-charts/haproxy) instead, a
# control-plane-only DaemonSet that forwards each node's real IP on
# 10257/10259 to that same node's 127.0.0.1 over a plain TCP proxy, never
# terminating or touching the components' own TLS/auth.
clusterNetwork:
  podSubnet: "10.244.0.0/16"
  serviceSubnet: "10.96.0.0/12"
  cni:
    external: {}
  kubeProxy:
    skipInstallation: true

machineController:
  deploy: false

operatingSystemManager:
  deploy: false

staticWorkers:
  hosts:
  {{- range $nodeGroupIndex, $nodeGroup := .BareMetalConfig.NodeGroups }}
  {{- range $hostIndex, $host := $nodeGroup.Hosts }}
    - {{- if and ($host.SSH) ($host.SSH.Port) }}
      sshPort: {{ $host.SSH.Port }}
      {{- else }}
      sshPort: {{ $.BareMetalConfig.SSH.Port }}
      {{- end }}

      {{- if and ($host.SSH) ($host.SSH.SSHKeyPairConfig) }}
      sshPrivateKeyFile: {{ $host.SSH.PrivateKeyFilePath }}
      {{- else if and ($.BareMetalConfig.SSH) ($.BareMetalConfig.SSH.SSHKeyPairConfig) }}
      sshPrivateKeyFile: {{ $.BareMetalConfig.SSH.PrivateKeyFilePath }}
      {{- end }}

      {{- if $host.PublicAddress }}
      publicAddress: {{ $host.PublicAddress }}
      {{- end }}
      {{- if $host.PrivateAddress }}
      privateAddress: {{ $host.PrivateAddress }}
      {{- end }}

      labels: {{- $nodeGroup.Labels | toIndentYAML 2 | nindent 8 }}
      taints: {{- $nodeGroup.Taints | toIndentYAML 2 | nindent 8 }}
      {{- if $.BareMetalConfig.Kubelet }}
      kubelet: {{- $.BareMetalConfig.Kubelet | toIndentYAML 2 | nindent 8 }}
      {{- end }}
  {{- end }}
  {{- end }}

dynamicWorkers: []

helmReleases:
  - repoURL: https://helm.cilium.io/
    chart: cilium
    version: 1.20.2
    releaseName: cilium
    namespace: cilium
    wait: true
    values:
      - inline:
          operator:
            replicas: 1
            rollOutPods: true
            priorityClassName: system-node-critical
          kubeProxyReplacement: "true"
          k8sServiceHost: "{{ .BareMetalConfig.ControlPlane.Endpoint.Host }}"
          k8sServicePort: "{{ .BareMetalConfig.ControlPlane.Endpoint.Port }}"
          ipam:
            mode: kubernetes
          rollOutCiliumPods: true
          priorityClassName: system-node-critical
          hubble:
            metrics:
              enabled:
                - dns:query;ignoreAAAA
                - drop
                - tcp
                - flow
                - icmp
                - http
            relay:
              enabled: true
              rollOutPods: true
            ui:
              enabled: true
              rollOutPods: true
